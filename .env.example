# Optional. Everything below can be set in the app under Settings (stored in ~/.tripdeck/config.json).
# Environment variables take precedence over Settings. Never commit .env.local.

# Google account sync (OAuth client of type "Web application",
# redirect URI http://localhost:3000/api/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OneDrive folder on this PC, when it isn't found automatically (trips go into its TripDeck subfolder)
# TRIPDECK_ONEDRIVE_FOLDER=

# Google Maps instead of OpenStreetMap
# GOOGLE_MAPS_API_KEY=              # server: Places API (New), Routes API, Elevation API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # browser: Maps JavaScript API (restrict by HTTP referrer); also built into
#                                   # the phone app for Google map tiles (Map Tiles API) – don't share that APK
# NEXT_PUBLIC_GOOGLE_MAP_ID=

# In-app AI buttons (not needed when planning through Claude/ChatGPT via MCP)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_FALLBACKS=off

# Where settings, the Google token and local trips are stored (default ~/.tripdeck)
# TRIPDECK_HOME=
