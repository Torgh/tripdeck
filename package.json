{
  "name": "tripdeck",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted trip planner: drag-and-drop days, Google Maps routes, dive planning with safety checks, booking import and Claude-powered suggestions.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "mcp": "bun mcp/server.ts",
    "dev:mobile": "vite --config mobile/vite.config.mts",
    "build:mobile": "vite build --config mobile/vite.config.mts",
    "android": "bun run build:mobile && cap sync android && cap run android",
    "icons:mobile": "node mobile/scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint && bun run test:coverage && bun run build && bun run build:mobile"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vis.gl/react-google-maps": "^1.10.1",
    "maplibre-gl": "^6.14.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/google.maps": "^3.66.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.5",
    "typescript": "5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
